script-source,52,node:internal/process/permission,'use strict';\n\nconst {\n  ObjectFreeze\x2C\n} = primordials;\n\nconst permission = internalBinding('permission');\nconst { validateString\x2C validateBuffer } = require('internal/validators');\nconst { Buffer } = require('buffer');\nconst { isBuffer } = Buffer;\n\nlet experimentalPermission;\n\nmodule.exports = ObjectFreeze({\n  __proto__: null\x2C\n  isEnabled() {\n    if (experimentalPermission === undefined) {\n      const { getOptionValue } = require('internal/options');\n      experimentalPermission = getOptionValue('--experimental-permission');\n    }\n    return experimentalPermission;\n  }\x2C\n  has(scope\x2C reference) {\n    validateString(scope\x2C 'scope');\n    if (reference != null) {\n      // TODO: add support for WHATWG URLs and Uint8Arrays.\n      if (isBuffer(reference)) {\n        validateBuffer(reference\x2C 'reference');\n      } else {\n        validateString(reference\x2C 'reference');\n      }\n    }\n\n    return permission.has(scope\x2C reference);\n  }\x2C\n});\n
